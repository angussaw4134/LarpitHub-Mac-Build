{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Larpit Hub",
  "version": "1.0.1",
  "identifier": "app.highzone.ipa-loader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1435",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Larpit Hub",
        "width": 940,
        "height": 795,
        "minWidth": 610,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "useLocalToolsDir": true,
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../LICENSE-BRANDING": "BRANDING.txt"
    }
  }
}